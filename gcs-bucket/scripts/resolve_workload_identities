#!/bin/bash
set -euo pipefail

# ---------------------------------------------------------------------------
# resolve_workload_identities <application_id>
#
# Prints, as a JSON array of {scope_id, namespace, service_account}, the
# Kubernetes service account each scope of the app runs as. The scopes create
# one per scope when they run with IAM.MODE gke: named <prefix>-<scope id> and
# labeled nullplatform=true and scope_id=<scope id>, in the scope's namespace.
#
# The service accounts are looked up in the cluster, not derived: the prefix and
# the namespace may be patterns the scopes render, and a name found by label is
# the one the pods really run as. A label alone can be set by anyone who can
# create a service account, so a match also needs a name ending in
# -<scope id> (as the scopes' resolver requires) and a trusted namespace:
# "nullplatform", one labeled nullplatform=true, or one listed in
# APP_K8S_NAMESPACES (values.yaml app_k8s_namespaces). Never default or kube-*.
#
# Needs `np` (scopes of the app) and `kubectl` with cluster-wide list on
# serviceaccounts and namespaces. Logs go to stderr.
# ---------------------------------------------------------------------------

APPLICATION_ID="${1:?usage: resolve_workload_identities <application_id>}"

if ! SCOPES_OUT=$(np scope list --application_id "$APPLICATION_ID" --limit 200 --format json 2>&1); then
  echo "ERROR: could not list the scopes of application ${APPLICATION_ID}: ${SCOPES_OUT}" >&2
  exit 1
fi
# Deleted (or deleting) scopes have no pods left to grant to.
SCOPE_IDS=$(printf '%s' "$SCOPES_OUT" | jq -c '
  [(.results // [])[] | select(((.status // "") | test("^delet")) | not) | .id | tostring]')
if [ "$(echo "$SCOPE_IDS" | jq 'length')" -eq 0 ]; then
  echo "ERROR: application ${APPLICATION_ID} has no scopes yet; create a scope, then create or update the link" >&2
  exit 1
fi

if ! command -v kubectl >/dev/null 2>&1; then
  echo "ERROR: kubectl is not on PATH; the worker image must ship it" >&2
  exit 1
fi
if ! SERVICE_ACCOUNTS=$(kubectl get serviceaccounts -A -l nullplatform=true -o json 2>&1); then
  echo "ERROR: could not list Kubernetes service accounts across namespaces: ${SERVICE_ACCOUNTS}" >&2
  echo "       The agent's Kubernetes service account needs cluster-wide list on serviceaccounts and namespaces." >&2
  exit 1
fi
if ! LABELED_NAMESPACES=$(kubectl get namespaces -l nullplatform=true -o json 2>&1); then
  echo "ERROR: could not list namespaces: ${LABELED_NAMESPACES}" >&2
  exit 1
fi

TRUSTED_NAMESPACES=$(jq -nc \
  --argjson labeled "$LABELED_NAMESPACES" --arg configured "${APP_K8S_NAMESPACES:-}" '
  ([ "nullplatform" ]
   + [ ($labeled.items // [])[].metadata.name ]
   + [ $configured | split(",")[] | gsub("^\\s+|\\s+$"; "") | select(. != "") ])
  | unique | map(select(. != "default" and (startswith("kube-") | not)))')

RESULT=$(jq -nc \
  --argjson scopes "$SCOPE_IDS" --argjson sas "$SERVICE_ACCOUNTS" --argjson trusted "$TRUSTED_NAMESPACES" '
  [ $scopes[] as $id
    | { scope_id: $id,
        matches: [ ($sas.items // [])[]
                   | select((.metadata.labels.scope_id // "") == $id
                            and (.metadata.name | endswith("-" + $id))
                            and (.metadata.namespace as $ns | any($trusted[]; . == $ns)))
                   | { namespace: .metadata.namespace, service_account: .metadata.name } ] } ]')

AMBIGUOUS=$(echo "$RESULT" | jq -r '[.[] | select((.matches | length) > 1) | .scope_id] | join(", ")')
if [ -n "$AMBIGUOUS" ]; then
  echo "ERROR: scopes with more than one Kubernetes service account labeled with their scope_id: ${AMBIGUOUS}" >&2
  echo "       Find them with: kubectl get serviceaccounts -A -l scope_id=<scope id>" >&2
  exit 1
fi

MISSING=$(echo "$RESULT" | jq -r '[.[] | select((.matches | length) == 0) | .scope_id] | join(", ")')
FOUND=$(echo "$RESULT" | jq -c '[.[] | select((.matches | length) == 1) | {scope_id} + .matches[0]]')

if [ "$(echo "$FOUND" | jq 'length')" -eq 0 ]; then
  echo "ERROR: no scope of application ${APPLICATION_ID} has its own Kubernetes service account (scopes: ${MISSING})." >&2
  echo "       The link grants the bucket to each scope's service account through Workload Identity, which the" >&2
  echo "       scopes create only with IAM.ENABLED true and IAM.MODE gke (nullplatform/scopes). Enable it, redeploy" >&2
  echo "       the scopes and retry. Trusted namespaces: $(echo "$TRUSTED_NAMESPACES" | jq -r 'join(", ")')." >&2
  exit 1
fi
if [ -n "$MISSING" ]; then
  # A scope still being created, or one without IAM.MODE gke: it gets the role
  # when the link is updated after its service account exists.
  echo "WARNING: scopes without their own Kubernetes service account get no access (update the link once they have one): ${MISSING}" >&2
fi

echo "$FOUND"
